# EmailJS — copy this file to .env and fill with your real values
# https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Agentic AI assistant — OpenAI-compatible chat endpoint (OpenAI, Gemini, Groq, etc.)
# Used server-side by the Vite dev proxy so the API key is never exposed to the browser.
VITE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_AI_API_KEY=sk-your_openai_compatible_key
VITE_AI_MODEL=gpt-4o-mini