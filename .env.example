# EmailJS — copy this file to .env and fill with your real values
# https://www.emailjs.com

# EmailJS service/template/public key (create a free account, then a Service
# and a Template whose "To Email" is {{to_email}} so mail lands in the inbox).
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
# Agentic AI assistant — OpenAI-compatible chat endpoint (OpenAI, Gemini, Groq, etc.)
# VITE_AI_ENDPOINT and VITE_AI_MODEL are intentionally VITE_-prefixed (safe to expose).
# AI_API_KEY is NOT VITE_-prefixed so Vite never exposes it to the browser; it is read
# server-side only (dev proxy / serverless deployment).
VITE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-your_openai_compatible_key
VITE_AI_MODEL=gpt-4o-mini